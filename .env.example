# Copy this file to `.env.local` for local development, and set the same names in
# your hosting provider's dashboard (e.g. Vercel > Project > Settings > Environment Variables).
#
# NEVER put real values in this file. It is committed to git; `.env` and `.env.local` are not.
# Variables prefixed NEXT_PUBLIC_ would be embedded in the browser bundle and are PUBLIC, so
# never use that prefix for a secret. Everything below stays on the server.

# --- Contact form email delivery (server-only, SECRET) -------------------------------------
# Create a key at https://resend.com/api-keys. Until these three are set, the contact form
# reports "unavailable" and points visitors to the direct email address instead of losing messages.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "BPPF Website <noreply@bppfindia.org>".
CONTACT_FROM_EMAIL=
